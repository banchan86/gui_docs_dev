<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.8.5"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:FileCapture">
          <cv:FileName>ForagingMouseExampleVid.avi</cv:FileName>
          <cv:PlaybackRate>0</cv:PlaybackRate>
          <cv:StartPosition>0</cv:StartPosition>
          <cv:PositionUnits>Frames</cv:PositionUnits>
          <cv:Loop>false</cv:Loop>
          <cv:Playing>true</cv:Playing>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:VideoWriter">
          <cv:FileName>ForagingMouseExample_copy.avi</cv:FileName>
          <cv:Suffix>Timestamp</cv:Suffix>
          <cv:Buffered>true</cv:Buffered>
          <cv:Overwrite>false</cv:Overwrite>
          <cv:FourCC>FMP4</cv:FourCC>
          <cv:FrameRate>30</cv:FrameRate>
          <cv:FrameSize>
            <cv:Width>0</cv:Width>
            <cv:Height>0</cv:Height>
          </cv:FrameSize>
          <cv:ResizeInterpolation>NearestNeighbor</cv:ResizeInterpolation>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:Grayscale" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:CropPolygon">
          <cv:Regions>
            <cv:ArrayOfPoint>
              <cv:Point>
                <cv:X>228</cv:X>
                <cv:Y>525</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>207</cv:X>
                <cv:Y>505</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>189</cv:X>
                <cv:Y>484</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>172</cv:X>
                <cv:Y>460</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>158</cv:X>
                <cv:Y>432</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>146</cv:X>
                <cv:Y>404</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>137</cv:X>
                <cv:Y>369</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>132</cv:X>
                <cv:Y>325</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>111</cv:X>
                <cv:Y>326</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>112</cv:X>
                <cv:Y>264</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>136</cv:X>
                <cv:Y>265</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>143</cv:X>
                <cv:Y>233</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>164</cv:X>
                <cv:Y>180</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>189</cv:X>
                <cv:Y>141</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>225</cv:X>
                <cv:Y>103</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>261</cv:X>
                <cv:Y>75</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>309</cv:X>
                <cv:Y>53</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>366</cv:X>
                <cv:Y>36</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>430</cv:X>
                <cv:Y>34</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>477</cv:X>
                <cv:Y>41</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>518</cv:X>
                <cv:Y>55</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>563</cv:X>
                <cv:Y>80</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>607</cv:X>
                <cv:Y>115</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>636</cv:X>
                <cv:Y>149</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>658</cv:X>
                <cv:Y>183</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>668</cv:X>
                <cv:Y>205</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>678</cv:X>
                <cv:Y>232</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>685</cv:X>
                <cv:Y>265</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>689</cv:X>
                <cv:Y>294</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>690</cv:X>
                <cv:Y>326</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>683</cv:X>
                <cv:Y>375</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>669</cv:X>
                <cv:Y>419</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>652</cv:X>
                <cv:Y>454</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>636</cv:X>
                <cv:Y>480</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>602</cv:X>
                <cv:Y>517</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>565</cv:X>
                <cv:Y>545</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>512</cv:X>
                <cv:Y>573</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>475</cv:X>
                <cv:Y>583</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>437</cv:X>
                <cv:Y>589</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>397</cv:X>
                <cv:Y>591</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>360</cv:X>
                <cv:Y>587</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>323</cv:X>
                <cv:Y>578</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>281</cv:X>
                <cv:Y>559</cv:Y>
              </cv:Point>
              <cv:Point>
                <cv:X>246</cv:X>
                <cv:Y>539</cv:Y>
              </cv:Point>
            </cv:ArrayOfPoint>
          </cv:Regions>
          <cv:MaskType>ToZero</cv:MaskType>
          <cv:FillValue>
            <cv:Val0>255</cv:Val0>
            <cv:Val1>255</cv:Val1>
            <cv:Val2>255</cv:Val2>
            <cv:Val3>255</cv:Val3>
          </cv:FillValue>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:Threshold">
          <cv:ThresholdValue>71</cv:ThresholdValue>
          <cv:MaxValue>255</cv:MaxValue>
          <cv:ThresholdType>BinaryInv</cv:ThresholdType>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:FindContours">
          <cv:Mode>External</cv:Mode>
          <cv:Method>ChainApproxNone</cv:Method>
          <cv:Offset>
            <cv:X>0</cv:X>
            <cv:Y>0</cv:Y>
          </cv:Offset>
          <cv:MinArea xsi:nil="true" />
          <cv:MaxArea xsi:nil="true" />
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:BinaryRegionAnalysis" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:LargestBinaryRegion" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:Centroid" />
      </Expression>
      <Expression xsi:type="io:CsvWriter">
        <io:FileName>mouse_centroid.csv</io:FileName>
        <io:Append>false</io:Append>
        <io:Overwrite>false</io:Overwrite>
        <io:Suffix>Timestamp</io:Suffix>
        <io:IncludeHeader>false</io:IncludeHeader>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="0" To="2" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>